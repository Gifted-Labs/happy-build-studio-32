# Build-time configuration. Values here are compiled into the client bundle, so
# every one of them is PUBLIC. Never put a secret in this file — the Turnstile
# secret and Resend key go to `wrangler secret put`. See .env.example.

# Turnstile PUBLIC site key.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFFMX0IyT2nP4kKz

VITE_SITE_URL=https://lifestorycharitablefoundation.com

# Public R2 bucket holding the project photographs.
VITE_MEDIA_HOST=https://pub-381d073b37954579b40c7b443f774a04.r2.dev
# Transforms are served by the zone at /cdn-cgi/image/, which does not exist on
# *.workers.dev. Leave false until lifestorycharitablefoundation.com is attached AND Image
# Transformations are enabled on that zone, or every image 404s.
VITE_IMAGE_TRANSFORM=false
