# Build-time configuration. Copy to `.env` at the repo root.
#
# These are baked into the client bundle at BUILD time, not read at runtime — so
# changing any of them requires a rebuild and redeploy. Every value here is public
# by nature (they all ship in the JS bundle), so committing `.env` is fine and is
# what makes a Lovable-side build pick them up. Real secrets never belong here;
# they go in `wrangler secret put` — see README.md.

# Turnstile PUBLIC site key, from the Cloudflare dashboard widget.
#
# REQUIRED IN PRODUCTION. Left unset, the build falls back to Cloudflare's
# always-passes TEST site key, and the forms break in one of two ways:
#   - with a real TURNSTILE_SECRET_KEY, siteverify rejects every test token, so
#     no genuine submission ever gets through;
#   - with the test secret too, everything passes and there is no bot protection
#     at all — which the Resend free tier (100 emails/day) will not survive.
VITE_TURNSTILE_SITE_KEY=

# Public origin, used for absolute URLs in the sitemap and social meta.
# Defaults to https://lifestorycharitablefoundation.com.
VITE_SITE_URL=https://lifestorycharitablefoundation.com

# Host serving the real photographs (the R2 bucket's public origin or a custom
# domain). Until this is set, every image on the site falls back to the temporary
# Stitch placeholder URLs in src/lib/media.ts. See that file for the object keys
# to upload to.
VITE_MEDIA_HOST=

# Set to enable Cloudflare image resizing/re-encoding on the fly (cfImage in
# src/lib/media.ts). Only meaningful once VITE_MEDIA_HOST points at Cloudflare.
VITE_IMAGE_TRANSFORM=
